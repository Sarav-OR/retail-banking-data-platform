# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git

# Alpha Vantage — free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# FRED (Federal Reserve) — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# Databricks (for notebook runs)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_token_here
